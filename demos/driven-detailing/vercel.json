{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    { "source": "/book", "destination": "/#book", "permanent": true },
    { "source": "/book/", "destination": "/#book", "permanent": true },
    { "source": "/referrals", "destination": "/#refer", "permanent": true },
    { "source": "/referrals/", "destination": "/#refer", "permanent": true },
    { "source": "/car-detailing-membership", "destination": "/", "permanent": true },
    { "source": "/car-detailing-membership/", "destination": "/", "permanent": true },
    { "source": "/car-detailing-membership/join", "destination": "/", "permanent": true },
    { "source": "/car-detailing-membership/join/", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(assets|fonts)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
