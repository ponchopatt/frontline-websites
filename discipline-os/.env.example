# Supabase project settings → API. The anon (or publishable) key is safe in the browser;
# every table is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: "Suggest my goals" asks Claude to refine its suggestions when one of these is set.
# Leave them out and the app suggests goals from your own numbers only. Server-side only.
# ANTHROPIC_API_KEY=
# Or, through a gateway: ANTHROPIC_AUTH_TOKEN= and ANTHROPIC_BASE_URL=
# AI_GOALS_MODEL=claude-opus-5
