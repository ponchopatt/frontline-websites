node_modules/
.next/
out/
dist/
dist-single/
build/
__pycache__/
*.pyc
.env
.env.local
.DS_Store
*.tsbuildinfo
.vercel
.scratch/
.scratch-shots/
logs/

# Reviewer screenshots. Regenerable, and PNG at 1440px is 6 MB a shot that git
# cannot delta — fourteen clients would put a quarter of a gigabyte of working
# artefacts in the history. A passing demo keeps a small webp pair instead.
clients/*/shots/
# Agents' throwaway scratch scripts (screenshot/tap-target/console checks
# written mid-task, meant to be deleted after use). Names vary — tmp_,
# _tmp_, -tmp-, _audit_tmp etc — so this catches any filename containing
# "tmp" rather than chasing each new spelling.
clients/*/*tmp*
*tmp*.mjs
tools/.rev-*
tools/.*.tmp.mjs
tools/*tmp*
dist-demos/
